# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Direct Connection String (Non-Pooling)
# Used by database migration and initialization scripts (setup-db.js, upgrade-db*.js)
POSTGRES_URL_NON_POOLING=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
